---
import { SITE } from '../config';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/400-italic.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/400-italic.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans/700.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  active?: 'wpisy' | 'o-mnie' | '';
  /** URLs of the language variants of the current post, e.g. { pl: '/wpisy/pl/hello-world/' } */
  counterpart?: Partial<Record<'pl' | 'en', string>>;
  /** external canonical address for syndicated content; defaults to the page's own URL */
  canonicalUrl?: string;
  /** what the link card says when the page is shared (LinkedIn, Slack, …); defaults to title + description */
  social?: { title?: string; description?: string; lang?: 'pl' | 'en' };
  /** posts are articles for Open Graph; everything else is a website */
  ogType?: 'website' | 'article';
  /** ISO date, only meaningful for articles */
  published?: string;
}
const {
  title, description = SITE.description, lang = 'pl', active = '', counterpart, canonicalUrl,
  social = {}, ogType = 'website', published,
} = Astro.props;
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
// without these LinkedIn scrapes the body and shows whatever it stumbles on
// (the latest recipe as the title, a random excerpt underneath)
const ogTitle = social.title ?? title;
const ogDescription = social.description ?? description;
const ogImage = new URL('/og.png', Astro.site).href; // tools/brand-gen.mjs
// the locale follows the card's copy, not the page's html lang — the home page
// reads Polish by default but introduces itself in English
const ogLocale = (social.lang ?? lang) === 'pl' ? 'pl_PL' : 'en_US';
---
<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.title} />
    {ogType === 'article' && published && <meta property="article:published_time" content={published} />}
    {ogType === 'article' && <meta property="article:author" content={SITE.author} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    {counterpart?.pl && <link rel="alternate" hreflang="pl" href={new URL(counterpart.pl, Astro.site)} />}
    {counterpart?.en && <link rel="alternate" hreflang="en" href={new URL(counterpart.en, Astro.site)} />}
    {/* bump ?v= after every icon change — browsers cache favicons very aggressively;
        site.js swaps both icon links to the -light variants together with the theme */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=8" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png?v=8" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=8" />
    <script is:inline>
      document.documentElement.dataset.theme = localStorage.getItem('theme') || 'dark';
    </script>
  </head>
  <body data-counterpart-pl={counterpart?.pl} data-counterpart-en={counterpart?.en}>
    <div class="shell">
      <nav class="top-nav" aria-label="nawigacja główna">
        <div class="brand-block">
          <a class="brand" href="/" aria-label="jRobertGardzinski">
            {/* pixel-art wordmark (transparent — no tile); the narrow layout swaps it for the
                compact jRG monogram. Both carry both theme variants; CSS shows the one matching
                data-theme, so the link works before JS and reacts instantly to the toggle. */}
            <span class="logo-wordmark">
              <img class="dark" src="/logo-long.svg?v=8" alt="" width="90" height="14" />
              <img class="light" src="/logo-long-light.svg?v=8" alt="" width="90" height="14" />
            </span>
            <span class="logo-mark">
              <img class="dark" src="/logo-mark.svg?v=8" alt="" width="14" height="14" />
              <img class="light" src="/logo-mark-light.svg?v=8" alt="" width="14" height="14" />
            </span>
          </a>
          {/* settings, not navigation — always at hand, also on mobile */}
          <div class="site-controls">
            <button id="theme-toggle" title="Przełącz motyw" type="button">Darcula</button>
            <div class="lang-switch">
              <button id="lang-pl" class="lang-btn" type="button">PL</button>
              <button id="lang-en" class="lang-btn" type="button">EN</button>
            </div>
          </div>
        </div>
        <button id="nav-toggle" class="nav-toggle" type="button" aria-label="menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
        <div class="nav-right">
          <a class:list={['nav-link', { active: active === 'wpisy' }]} href="/" data-label-pl="wpisy" data-label-en="posts">wpisy</a>
          <a class:list={['nav-link', { active: active === 'o-mnie' }]} href="/o-mnie/" data-label-pl="o-mnie" data-label-en="about-me">o-mnie</a>
        </div>
      </nav>
      <slot />
    </div>
    <script>
      import '../scripts/site.js';
    </script>
    {SITE.goatcounterCode && (
      <script
        is:inline
        data-goatcounter={`https://${SITE.goatcounterCode}.goatcounter.com/count`}
        async
        src="https://gc.zgo.at/count.js"
      ></script>
    )}
  </body>
</html>
