---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import FeaturedCard from '../components/FeaturedCard.astro';
import { SITE } from '../config';
import { allPosts, langOf } from '../lib/posts';
import photo from '../assets/robert.jpg';

const posts = await allPosts();
const featuredPl = posts.find((p) => langOf(p) === 'pl');
const featuredEn = posts.find((p) => langOf(p) === 'en');

// the same photo in both language blocks — 2x the 96px display size, for retina.
// the square crop itself is CSS's job (.avatar / object-fit).
// eager, because it sits above the fold — lazy only delays what is visible on arrival
const AVATAR = { src: photo, width: 192, alt: 'Robert Gardziński', loading: 'eager' };
// the same file again, full size, for the lightbox — lazy, since it costs
// nothing until someone actually clicks the thumbnail
const AVATAR_FULL = { src: photo, width: 1000, alt: 'Robert Gardziński', loading: 'lazy' };
---
<Base title={`About me — ${SITE.title}`} active="o-mnie">
  <main class="page about">
    <div class="lang-block" data-lang="pl">
      <header class="about-header">
        <button class="avatar-button" type="button" data-lightbox-open aria-label="Powiększ zdjęcie">
          <Image class="avatar" {...AVATAR} />
        </button>
        <div class="about-intro">
          <p class="about-comment">// „j" jak w dobrych bibliotekach: jUnit, jOOQ, jRG</p>
          <h1 class="about-title">Cześć, jestem Robert.</h1>
          <p>
            Backend w Javie — od zawsze Spring, od niedawna rozglądam się za alternatywami. Architektura
            heksagonalna, DDD i przekonanie, że dobry kod czyta się jak dobrą prozę. Piszę po polsku i po
            angielsku — zależnie od tematu i humoru.
          </p>
        </div>
      </header>

      <section>
        <h2 class="section-heading">// czym się zajmuję</h2>
        <div class="cards-grid">
          <div class="about-card">
            <p class="card-title">programowanie</p>
            <p>Moja wizytówka. Backend w Javie, porty i adaptery, agregaty które naprawdę coś agregują.</p>
          </div>
          <div class="about-card">
            <p class="card-title">f1</p>
            <p>Na pauzie. Wrócę, jak regulacje przestaną psuć wyścigi. Kiedyś to było.</p>
          </div>
          <div class="about-card">
            <p class="card-title">diy</p>
            <p>Refaktoring, ale w mieszkaniu. Wiertarka to taki debugger do ścian.</p>
          </div>
          <div class="about-card">
            <p class="card-title">gotowanie</p>
            <p>Od czasu do czasu coś mi się uda. Trzymam się przepisu jak specyfikacji.</p>
          </div>
        </div>
      </section>

      <dialog class="lightbox" data-lightbox aria-label="Zdjęcie autora">
        <button class="lightbox-close" type="button" data-lightbox-close aria-label="Zamknij">×</button>
        <Image class="lightbox-img" {...AVATAR_FULL} />
      </dialog>
    </div>

    <div class="lang-block" data-lang="en" hidden>
      <header class="about-header">
        <button class="avatar-button" type="button" data-lightbox-open aria-label="Enlarge photo">
          <Image class="avatar" {...AVATAR} />
        </button>
        <div class="about-intro">
          <p class="about-comment">// "j" as in good libraries: jUnit, jOOQ, jRG</p>
          <h1 class="about-title">Hi, I'm Robert.</h1>
          <p>
            Java backend — Spring since forever, lately looking around at the alternatives. Hexagonal
            architecture, DDD and the conviction that good code reads like good prose. I write in Polish
            and in English — depending on the topic and the mood.
          </p>
        </div>
      </header>

      <section>
        <h2 class="section-heading">// what I do</h2>
        <div class="cards-grid">
          <div class="about-card">
            <p class="card-title">programming</p>
            <p>My calling card. Java backends, ports and adapters, aggregates that actually aggregate.</p>
          </div>
          <div class="about-card">
            <p class="card-title">f1</p>
            <p>On hold. I'll be back when the regulations stop ruining the racing. It used to be great.</p>
          </div>
          <div class="about-card">
            <p class="card-title">diy</p>
            <p>Refactoring, but for the apartment. A drill is just a debugger for walls.</p>
          </div>
          <div class="about-card">
            <p class="card-title">cooking</p>
            <p>Every now and then something works out. I follow the recipe like a spec.</p>
          </div>
        </div>
      </section>

      <dialog class="lightbox" data-lightbox aria-label="Author's photo">
        <button class="lightbox-close" type="button" data-lightbox-close aria-label="Close">×</button>
        <Image class="lightbox-img" {...AVATAR_FULL} />
      </dialog>
    </div>

    {featuredPl && <FeaturedCard post={featuredPl} small showDate={false} />}
    {featuredEn && <FeaturedCard post={featuredEn} small showDate={false} hidden />}

    <Footer />
  </main>
  <script>
    import { getLang } from '../scripts/site.js';

    // every language block carries its own lightbox, so the labels stay bilingual
    // the same way the rest of this page does
    for (const block of document.querySelectorAll('.lang-block')) {
      const dialog = block.querySelector('[data-lightbox]');
      if (!dialog) continue;
      block.querySelector('[data-lightbox-open]')?.addEventListener('click', () => dialog.showModal());
      dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
      // a click that lands on the dialog itself came from the backdrop, not from the
      // photo; Escape needs no handler, <dialog> closes on it natively
      dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    }

    const applyLang = () => {
      const lang = getLang();
      for (const block of document.querySelectorAll('.lang-block')) {
        block.hidden = block.dataset.lang !== lang;
      }
      for (const card of document.querySelectorAll('.featured-card[data-lang]')) {
        card.hidden = card.dataset.lang !== lang;
      }
    };
    document.addEventListener('langchange', applyLang);
    applyLang();
  </script>
</Base>
