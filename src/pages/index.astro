---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import FeaturedCard from '../components/FeaturedCard.astro';
import { SITE, SECTIONS } from '../config';
import { allPosts, groupBySlug, urlOf, excerptOf, readingTimeOf, fmtDate, searchTextOf, langOf } from '../lib/posts';
import { postCountLabel, DEFAULT_LANG } from '../lib/i18n.js';

const posts = await allPosts();
const groups = groupBySlug(posts);
const allProjects = [...new Set(posts.map((p) => p.data.project).filter(Boolean))] as string[];

// projects and tags belong to sections — the chip rows narrow down to the selected section
const sectionsOf = (matches: (p: (typeof posts)[number]) => boolean) =>
  [...new Set(posts.filter(matches).map((p) => p.data.section))].join(',');

// Tags are written in the language of the post, so a tag used only by Polish
// posts has no business in the English row and vice versa. A tag that appears in
// both languages (claude, kafka, ddd — words that don't translate) is neutral and
// stays in both rows; home.js hides the rest outside their own language.
const tagLangs = new Map<string, Set<string>>();
for (const p of posts) {
  for (const t of p.data.tags) {
    if (!tagLangs.has(t)) tagLangs.set(t, new Set());
    tagLangs.get(t)!.add(langOf(p));
  }
}
const tagChips = [...tagLangs].map(([tag, langs]) => ({
  tag,
  lang: langs.size === 1 ? [...langs][0] : undefined,
  sections: sectionsOf((p) => p.data.tags.includes(tag)),
}));
const featuredPl = posts.find((p) => langOf(p) === 'pl');
const featuredEn = posts.find((p) => langOf(p) === 'en');
// the HTML below is what a visitor sees before home.js runs (and what a crawler
// sees at all): the default language, with the other one rendered but hidden
const L = DEFAULT_LANG;
const T = {
  pl: { search: 'szukaj wpisów…', sections: 'działy:', projects: 'projekty:', tags: 'tagi:', clear: '× wyczyść filtry', empty: '// brak wyników — NoSuchPostException' },
  en: { search: 'search posts…', sections: 'sections:', projects: 'projects:', tags: 'tags:', clear: '× clear filters', empty: '// no results — NoSuchPostException' },
}[L];
const visibleCount = groups.filter((g) => g.langs.includes(L)).length;
---
<Base title={`${SITE.title} — ${SITE.tagline}`} active="wpisy" social={SITE.social}>
  <main class="page home">
    {featuredPl && <FeaturedCard post={featuredPl} hidden={L !== 'pl'} />}
    {featuredEn && <FeaturedCard post={featuredEn} hidden={L !== 'en'} />}

    <section class="filters" id="filtry">
      <div class="search-box">
        <span class="prompt">&gt;</span>
        <input
          id="search-input"
          placeholder={T.search}
          data-placeholder-pl="szukaj wpisów…"
          data-placeholder-en="search posts…"
          autocomplete="off"
        />
      </div>
      <div class="filter-row" data-filter="sections">
        <span class="filter-label" data-i18n-pl="działy:" data-i18n-en="sections:">{T.sections}</span>
        {SECTIONS.map((s) => (
          <button type="button" class="chip" data-value={s.id} data-label-pl={s.pl} data-label-en={s.en}>{s[L]}</button>
        ))}
      </div>
      <div class="filter-row" data-filter="projects">
        <span class="filter-label" data-i18n-pl="projekty:" data-i18n-en="projects:">{T.projects}</span>
        {allProjects.map((p) => (
          <button type="button" class="chip" data-value={p} data-sections={sectionsOf((post) => post.data.project === p)}>~/{p}</button>
        ))}
        <span class="chip-none" hidden={allProjects.length > 0}>–</span>
      </div>
      <div class="filter-row" data-filter="tags">
        <span class="filter-label" data-i18n-pl="tagi:" data-i18n-en="tags:">{T.tags}</span>
        {tagChips.map((c) => (
          <button type="button" class="chip" data-value={c.tag} data-lang={c.lang} data-sections={c.sections}>#{c.tag}</button>
        ))}
        <span class="chip-none" hidden={tagChips.length > 0}>–</span>
      </div>
      <div class="filters-footer">
        <span id="result-count">{postCountLabel(visibleCount, L)}</span>
        <button
          type="button"
          id="clear-filters"
          class="clear-filters"
          data-i18n-pl="× wyczyść filtry"
          data-i18n-en="× clear filters"
          hidden
        >{T.clear}</button>
      </div>
    </section>

    <section class="post-list-wrap">
      <div id="post-list" data-per-page={SITE.postsPerPage}>
        {groups.map((g) => (
          <article
            class="post-row"
            data-langs={g.langs.join(',')}
            data-section={g.section}
            data-project={g.project}
            data-tags-pl={g.tags.pl.join(',')}
            data-tags-en={g.tags.en.join(',')}
            data-search-pl={g.variants.pl && searchTextOf(g.variants.pl)}
            data-search-en={g.variants.en && searchTextOf(g.variants.en)}
            hidden={!g.langs.includes(L)}
          >
            {g.langs.map((l) => {
              const p = g.variants[l]!;
              return (
                <div class="variant" data-lang={l} hidden={l !== L && g.langs.includes(L)}>
                  <div class="row-head">
                    <h3 class="row-title"><a href={urlOf(p)}>{p.data.title}</a></h3>
                    <span class="lang-badge">{g.langs.length > 1 ? 'PL/EN' : l.toUpperCase()}</span>
                    {p.data.draft && <span class="lang-badge draft-badge">szkic</span>}
                  </div>
                  <p class="row-excerpt">{excerptOf(p)}</p>
                  <div class="row-meta">
                    <span>{fmtDate(p.data.date)}</span><span>·</span><span>{readingTimeOf(p)} min</span><span>·</span>
                    {p.data.tags.map((t) => <button type="button" class="meta-tag" data-value={t}>#{t}</button>)}
                    {g.project && <span class="meta-project">~/{g.project}</span>}
                  </div>
                </div>
              );
            })}
          </article>
        ))}
      </div>
      <p
        id="empty-state"
        class="empty-state"
        data-i18n-pl="// brak wyników — NoSuchPostException"
        data-i18n-en="// no results — NoSuchPostException"
        hidden
      >{T.empty}</p>
      <div id="pager" class="pager" hidden></div>
    </section>

    <Footer />
  </main>
  <script>
    import '../scripts/home.js';
  </script>
</Base>
