---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Footer from '../../../components/Footer.astro';
import { SITE } from '../../../config';
import { allPosts, slugOf, urlOf, excerptOf, readingTimeOf, updatedOf, fmtDate, langOf, type Post } from '../../../lib/posts';
import { fetchViewCount, formatViews, VIEW_FORMS } from '../../../lib/views';

export async function getStaticPaths() {
  const posts = await allPosts();
  return posts.map((post) => ({ params: { lang: langOf(post), slug: slugOf(post) }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const posts = await allPosts();
const slug = slugOf(post);
const counterpartPost = posts.find((p) => slugOf(p) === slug && langOf(p) !== langOf(post));
const sameLang = posts.filter((p) => langOf(p) === langOf(post));
const idx = sameLang.findIndex((p) => p.id === post.id);
const newer = idx > 0 ? sameLang[idx - 1] : null;
const older = idx >= 0 && idx < sameLang.length - 1 ? sameLang[idx + 1] : null;
const badge = counterpartPost ? 'PL/EN' : langOf(post).toUpperCase();
const updated = updatedOf(post);
const historyUrl = SITE.repoUrl ? `${SITE.repoUrl}/commits/main/src/content/posts/${post.id}.md` : null;
const counterpart = {
  [langOf(post)]: urlOf(post),
  ...(counterpartPost ? { [langOf(counterpartPost)]: urlOf(counterpartPost) } : {}),
};
const { Content } = await render(post);
// baked in at build time so blockers cannot take the counter away — see src/lib/views.ts
const views = await fetchViewCount(urlOf(post));
const viewsLabel = views === null ? '' : formatViews(views, langOf(post));
// post chrome speaks the post's language
const T = langOf(post) === 'pl'
  ? {
      back: '← wpisy',
      updated: 'zaktualizowano',
      comments: '// komentarze',
      noOlder: '← starszych wpisów brak',
      noNewer: 'nowszych wpisów brak →',
      history: 'historia zmian ↗',
    }
  : {
      back: '← posts',
      updated: 'updated',
      comments: '// comments',
      noOlder: '← no older posts',
      noNewer: 'no newer posts →',
      history: 'change history ↗',
    };
---
<Base
  title={`${post.data.title} — ${SITE.title}`}
  description={excerptOf(post)}
  lang={langOf(post)}
  active="wpisy"
  counterpart={counterpart}
  canonicalUrl={post.data.canonicalUrl}
>
  <main class="page post">
    <p class="back-link mono"><a href="/">{T.back}</a></p>

    <header class="post-header">
      <h1 class="post-title">{post.data.title}</h1>
      {/* two lines on purpose: what the post IS (date, length, traffic) above,
          how it is LABELLED (language, draft, tags) below — the second line is the
          one that grows without limit, so it gets its own row instead of pushing
          the numbers around. Every separator sits BEFORE its item, so an optional
          item that never arrives cannot leave a dangling "·" at the end. */}
      <div class="post-meta mono">
        <span>{fmtDate(post.data.date)}</span><span>·</span><span>{readingTimeOf(post)} min</span>
        {updated && <><span>·</span><span class="post-updated">{T.updated} {fmtDate(updated)}</span></>}
        {/* rendered at build time, refreshed by the script below when the reader's
            browser can reach GoatCounter; hidden while there is no number at all */}
        {SITE.goatcounterCode && (
          <><span class="post-views-sep" id="post-views-sep" hidden={!viewsLabel}>·</span><span class="post-views" id="post-views" hidden={!viewsLabel}>{viewsLabel}</span></>
        )}
      </div>
      <div class="post-labels mono">
        <span class="lang-badge">{badge}</span>
        {post.data.draft && <span class="lang-badge draft-badge">szkic</span>}
        {post.data.tags.map((t) => <span class="tag-chip">#{t}</span>)}
      </div>
    </header>

    {SITE.goatcounterCode && (
      <script is:inline define:vars={{ code: SITE.goatcounterCode, proxy: SITE.viewsProxy, baked: views ?? 0, lang: langOf(post), forms: VIEW_FORMS[langOf(post)] }}>
        // Refresh for the number already rendered above. The build baked in the count
        // it saw at deploy time (src/lib/views.ts); this walks fresher sources and
        // NEVER lowers or hides what the build put there — that is the whole point
        // of baking it in. Sources, in order of preference:
        //   1. the first-party proxy (proxy/README.md) — near-real-time, and being
        //      same-site it is invisible to tracker blocklists;
        //   2. goatcounter.com directly — cached ~4 hours on their side, and blocked
        //      outright by ad blockers and most mobile tracking protection
        //      (EasyPrivacy carries `||goatcounter.com^$third-party`), which is
        //      exactly why the number is baked into the HTML and proxied at all.
        //
        // Doing nothing is the correct reader-facing behaviour but a terrible way to
        // debug, so every path out of here says WHY in the console:
        //   404 — the source has no number for this path. GoatCounter's public
        //         endpoint additionally caches responses (404s included) for ~4 h;
        //   TypeError/network — the request never left the browser (blocker) or the
        //         host does not resolve (proxy not deployed yet). Both are expected
        //         states, not faults.
        (async () => {
          const log = (msg) => console.info(`[views] ${msg}`);
          const p = location.pathname;
          const sources = [];
          if (proxy) sources.push(`${proxy}${p}`);
          // GoatCounter may have the path stored with or without the trailing slash;
          // its endpoint is /counter/ + the path *including* its leading slash, so a
          // real URL carries a double slash: /counter//wpisy/pl/slug/.json
          const gcPaths = p.endsWith('/') && p !== '/' ? [p, p.slice(0, -1)] : [p];
          for (const path of gcPaths) sources.push(`https://${code}.goatcounter.com/counter/${path}.json`);
          for (const url of sources) {
            let count;
            try {
              // no-store, because GoatCounter answers with `cache-control: public` and
              // an `expires` hours ahead — and that covers its 404s too. Without it the
              // browser replays the first miss from disk for the rest of the day.
              const res = await fetch(url, { cache: 'no-store' });
              if (!res.ok) {
                log(`${res.status} z ${url} — to źródło nie ma liczby dla tej ścieżki`);
                continue;
              }
              // count_unique is documented as identical to count and kept only for
              // backwards compatibility — "should not be used for new code"
              ({ count } = await res.json());
            } catch (err) {
              log(`żądanie do ${url} nie wyszło z przeglądarki (${err}) — bloker, brak sieci albo host jeszcze nie istnieje; próbuję następne źródło`);
              continue;
            }
            const n = Number(String(count).replace(/\D/g, ''));
            if (!n) {
              log(`${url} ma zero wyświetleń — pomijam`);
              continue;
            }
            // sources are ordered freshest-first, so the first hit decides; anything
            // not newer than the build's number is the 4h cache lagging behind
            if (n <= baked) {
              log(`${url} zwróciło ${n}, nie więcej niż liczba z builda (${baked}) — zostaje liczba z builda`);
              return;
            }
            const form = forms[new Intl.PluralRules(lang).select(n)] ?? forms.other;
            const views = document.getElementById('post-views');
            views.textContent = `${n.toLocaleString(lang)} ${form}`;
            views.hidden = false;
            document.getElementById('post-views-sep').hidden = false;
            return;
          }
        })();
      </script>
    )}

    {!counterpart.pl && (
      <p class="translation-notice mono-comment" id="no-pl-notice" hidden>
        // brak polskiej wersji tego wpisu — NoSuchTranslationException
      </p>
    )}
    {!counterpart.en && (
      <p class="translation-notice mono-comment" id="no-en-notice" hidden>
        // no English version of this post yet — NoSuchTranslationException
      </p>
    )}

    <article class="post-body">
      <Content />
    </article>

    {historyUrl && (
      <p class="post-history mono"><a href={historyUrl}>{T.history}</a></p>
    )}

    <section class="comments">
      <h2 class="section-heading">{T.comments}</h2>
      {SITE.disqusShortname ? (
        <div id="disqus_thread"></div>
      ) : (
        <div class="disqus-fallback">// Disqus nie skonfigurowany — ustaw disqusShortname w src/config.ts</div>
      )}
    </section>
    {SITE.disqusShortname && (
      <script is:inline define:vars={{ shortname: SITE.disqusShortname, identifier: slug, pageTitle: post.data.title }}>
        window.disqus_config = function () {
          this.page.url = location.href;
          this.page.identifier = identifier;
          this.page.title = pageTitle;
        };
        const s = document.createElement('script');
        s.src = 'https://' + shortname + '.disqus.com/embed.js';
        s.setAttribute('data-timestamp', +new Date());
        document.body.appendChild(s);
      </script>
    )}

    <nav class="post-nav mono">
      {older ? <a href={urlOf(older)}>← {older.data.title}</a> : <span>{T.noOlder}</span>}
      {newer ? <a href={urlOf(newer)}>{newer.data.title} →</a> : <span>{T.noNewer}</span>}
    </nav>

    <Footer />
  </main>
</Base>
