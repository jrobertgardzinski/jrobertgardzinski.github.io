---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Footer from '../../../components/Footer.astro';
import { SITE } from '../../../config';
import { allPosts, slugOf, urlOf, excerptOf, readingTimeOf, updatedOf, fmtDate, langOf, type Post } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await allPosts();
  return posts.map((post) => ({ params: { lang: langOf(post), slug: slugOf(post) }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const posts = await allPosts();
const slug = slugOf(post);
const counterpartPost = posts.find((p) => slugOf(p) === slug && langOf(p) !== langOf(post));
const sameLang = posts.filter((p) => langOf(p) === langOf(post));
const idx = sameLang.findIndex((p) => p.id === post.id);
const newer = idx > 0 ? sameLang[idx - 1] : null;
const older = idx >= 0 && idx < sameLang.length - 1 ? sameLang[idx + 1] : null;
const badge = counterpartPost ? 'PL/EN' : langOf(post).toUpperCase();
const updated = updatedOf(post);
const historyUrl = SITE.repoUrl ? `${SITE.repoUrl}/commits/main/src/content/posts/${post.id}.md` : null;
const counterpart = {
  [langOf(post)]: urlOf(post),
  ...(counterpartPost ? { [langOf(counterpartPost)]: urlOf(counterpartPost) } : {}),
};
const { Content } = await render(post);
// post chrome speaks the post's language
const T = langOf(post) === 'pl'
  ? {
      back: '← wpisy',
      updated: 'zaktualizowano',
      comments: '// komentarze',
      noOlder: '← starszych wpisów brak',
      noNewer: 'nowszych wpisów brak →',
      history: 'historia zmian ↗',
      // we show count_unique — visits, the word GoatCounter's own dashboard uses —
      // rather than pageviews. Intl.PluralRules categories: "1 wizyta", "3 wizyty", "5 wizyt"
      views: { one: 'wizyta', few: 'wizyty', many: 'wizyt', other: 'wizyt' },
    }
  : {
      back: '← posts',
      updated: 'updated',
      comments: '// comments',
      noOlder: '← no older posts',
      noNewer: 'no newer posts →',
      history: 'change history ↗',
      views: { one: 'visit', other: 'visits' },
    };
---
<Base
  title={`${post.data.title} — ${SITE.title}`}
  description={excerptOf(post)}
  lang={langOf(post)}
  active="wpisy"
  counterpart={counterpart}
  canonicalUrl={post.data.canonicalUrl}
>
  <main class="page post">
    <p class="back-link mono"><a href="/">{T.back}</a></p>

    <header class="post-header">
      <h1 class="post-title">{post.data.title}</h1>
      {/* two lines on purpose: what the post IS (date, length, traffic) above,
          how it is LABELLED (language, draft, tags) below — the second line is the
          one that grows without limit, so it gets its own row instead of pushing
          the numbers around. Every separator sits BEFORE its item, so an optional
          item that never arrives cannot leave a dangling "·" at the end. */}
      <div class="post-meta mono">
        <span>{fmtDate(post.data.date)}</span><span>·</span><span>{readingTimeOf(post)} min</span>
        {updated && <><span>·</span><span class="post-updated">{T.updated} {fmtDate(updated)}</span></>}
        {/* filled in by the script below; stays hidden when GoatCounter has no number for this page */}
        {SITE.goatcounterCode && (
          <><span class="post-views-sep" id="post-views-sep" hidden>·</span><span class="post-views" id="post-views" hidden></span></>
        )}
      </div>
      <div class="post-labels mono">
        <span class="lang-badge">{badge}</span>
        {post.data.draft && <span class="lang-badge draft-badge">szkic</span>}
        {post.data.tags.map((t) => <span class="tag-chip">#{t}</span>)}
      </div>
    </header>

    {SITE.goatcounterCode && (
      <script is:inline define:vars={{ code: SITE.goatcounterCode, lang: langOf(post), forms: T.views }}>
        // Reader-facing view count, straight from the GoatCounter public counts endpoint
        // (needs "Allow adding visitor counts to your website" enabled in site settings).
        // Every failure mode — endpoint off, page not visited yet, request blocked —
        // simply leaves the counter hidden, so the meta line never shows a broken number.
        //
        // Silence is the correct reader-facing behaviour but a terrible way to debug,
        // so every path out of here says WHY in the console. Two failure modes look
        // identical from the outside and mean opposite things:
        //   404 — GoatCounter rebuilds these counts periodically, so a page visited
        //         minutes ago legitimately has no number yet;
        //   TypeError/network — the request never left the browser: goatcounter.com
        //         sits on the standard tracker blocklists, so an ad blocker or strict
        //         tracking protection kills it. Everyone else still sees the counter.
        (async () => {
          const p = location.pathname;
          // GoatCounter may have the path stored with or without the trailing slash
          const paths = p.endsWith('/') && p !== '/' ? [p, p.slice(0, -1)] : [p];
          const log = (msg) => console.info(`[views] ${msg}`);
          for (const path of paths) {
            const url = `https://${code}.goatcounter.com/counter${path}.json`;
            let count;
            try {
              // no-store, because GoatCounter answers with `cache-control: public` and an
              // `expires` hours ahead — and that covers its 404s too. Without it the browser
              // replays the first miss from disk for the rest of the day, so the counter
              // never returns, not even on reload.
              const res = await fetch(url, { cache: 'no-store' });
              if (!res.ok) {
                log(`${res.status} dla ${path} — GoatCounter nie ma liczby dla tej ścieżki. Ich cache zapamiętuje odpowiedź (także 404) przy PIERWSZYM pytaniu o daną ścieżkę i trzyma ją ok. 4 godzin; nagłówek age w odpowiedzi mówi, ile ta pustka ma już lat. Nie da się tego obejść z przeglądarki — ani parametrem w URL-u, ani no-cache.`);
                continue;
              }
              // count = pageviews, count_unique = visits; we take the latter, because ten
              // reloads by one person are not ten readers
              ({ count_unique: count } = await res.json());
            } catch (err) {
              // network/CORS failure — retrying the other path would fail too
              log(`żądanie do ${url} nie wyszło z przeglądarki (${err}) — najczęściej blokuje je bloker reklam albo ochrona przed śledzeniem`);
              return;
            }
            const n = Number(String(count).replace(/\D/g, ''));
            if (!n) {
              log(`ścieżka ${path} ma zero wyświetleń — licznik zostaje ukryty`);
              continue;
            }
            const form = forms[new Intl.PluralRules(lang).select(n)] ?? forms.other;
            const views = document.getElementById('post-views');
            views.textContent = `${n.toLocaleString(lang)} ${form}`;
            views.hidden = false;
            document.getElementById('post-views-sep').hidden = false;
            return;
          }
        })();
      </script>
    )}

    {!counterpart.pl && (
      <p class="translation-notice mono-comment" id="no-pl-notice" hidden>
        // brak polskiej wersji tego wpisu — NoSuchTranslationException
      </p>
    )}
    {!counterpart.en && (
      <p class="translation-notice mono-comment" id="no-en-notice" hidden>
        // no English version of this post yet — NoSuchTranslationException
      </p>
    )}

    <article class="post-body">
      <Content />
    </article>

    {historyUrl && (
      <p class="post-history mono"><a href={historyUrl}>{T.history}</a></p>
    )}

    <section class="comments">
      <h2 class="section-heading">{T.comments}</h2>
      {SITE.disqusShortname ? (
        <div id="disqus_thread"></div>
      ) : (
        <div class="disqus-fallback">// Disqus nie skonfigurowany — ustaw disqusShortname w src/config.ts</div>
      )}
    </section>
    {SITE.disqusShortname && (
      <script is:inline define:vars={{ shortname: SITE.disqusShortname, identifier: slug, pageTitle: post.data.title }}>
        window.disqus_config = function () {
          this.page.url = location.href;
          this.page.identifier = identifier;
          this.page.title = pageTitle;
        };
        const s = document.createElement('script');
        s.src = 'https://' + shortname + '.disqus.com/embed.js';
        s.setAttribute('data-timestamp', +new Date());
        document.body.appendChild(s);
      </script>
    )}

    <nav class="post-nav mono">
      {older ? <a href={urlOf(older)}>← {older.data.title}</a> : <span>{T.noOlder}</span>}
      {newer ? <a href={urlOf(newer)}>{newer.data.title} →</a> : <span>{T.noNewer}</span>}
    </nav>

    <Footer />
  </main>
</Base>
